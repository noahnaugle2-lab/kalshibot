[Unit]
Description=KalshiBot production-path dry-run supervisor (proposal-only)
After=network-online.target kalshibot.service
Wants=network-online.target
ConditionPathExists=/etc/kalshibot-live-dry-run.env
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=kalshi
WorkingDirectory=/home/kalshi/kalshibot
EnvironmentFile=/etc/kalshibot-live-dry-run.env
ExecStart=/home/kalshi/kalshibot/.venv/bin/python scripts/run_live_dry_run.py
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/kalshi/kalshibot/data /home/kalshi/kalshibot/logs
MemoryMax=1G
TasksMax=256
LimitNOFILE=8192
TimeoutStopSec=30
StandardOutput=append:/home/kalshi/kalshibot/logs/live-dry-run.log
StandardError=append:/home/kalshi/kalshibot/logs/live-dry-run.log

# Deliberately no [Install] section. Operators start this companion only for
# an explicitly approved rehearsal; it never starts on boot or deployment.
