[Unit]
Description=KalshiBot Cloudflare Tunnel
After=network-online.target kalshibot.service
Wants=network-online.target

[Service]
Type=simple
User=kalshi
WorkingDirectory=/home/kalshi/kalshibot
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --config /home/kalshi/kalshibot/deploy/cloudflared-kalshibot.yml run kalshibot
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/kalshi/kalshibot/logs /home/kalshi/.cloudflared
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096
StandardOutput=append:/home/kalshi/kalshibot/logs/tunnel.log
StandardError=append:/home/kalshi/kalshibot/logs/tunnel.log

[Install]
WantedBy=multi-user.target
