[Unit]
Description=KalshiBot shadow trader
After=network-online.target docker.service
Wants=network-online.target
# If a supervised task crashes the process (SystemExit 1) repeatedly, stop
# restarting after 5 failures in 5 min so a genuinely broken deploy doesn't
# crash-loop — the process staying down stops the Healthchecks.io pings, which
# escalates to an external alert (the dead man's switch).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kalshi
WorkingDirectory=/home/kalshi/kalshibot
ExecStart=/home/kalshi/kalshibot/.venv/bin/python scripts/run_shadow.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/kalshi/kalshibot/data /home/kalshi/kalshibot/logs
MemoryMax=2G
TasksMax=256
LimitNOFILE=8192
TimeoutStopSec=30
StandardOutput=append:/home/kalshi/kalshibot/logs/shadow.log
StandardError=append:/home/kalshi/kalshibot/logs/shadow.log

[Install]
WantedBy=multi-user.target
