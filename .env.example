# ── Kalshi API credentials ─────────────────────────────────────────────
# Create at https://kalshi.com (production) or https://demo.kalshi.co (demo).
# Key ID is a UUID; the private key is the RSA PEM file you downloaded at creation.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Demo environment has its OWN separate key pair. Only needed for order-plumbing
# tests (MODE=DEMO). Leave blank otherwise.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

# ── Trading mode ───────────────────────────────────────────────────────
# SHADOW = production market data, simulated fills, NO real orders (default)
# DEMO   = demo exchange, real order plumbing against fake money
# LIVE   = production, real money. Never enable until shadow validation passes.
MODE=SHADOW

# LIVE has no default order path.  A future deliberate go-live requires ALL
# of these exact settings, a production key with write scope, and deployment
# of the separate live service.  Keep these values unset until that review.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_ALLOWED_ASSETS=
LIVE_MAX_CONTRACTS_PER_ORDER=1
LIVE_MAX_DAILY_LOSS_USD=5
# Dry-run supervisor only: evaluates and records order proposals, never sends
# an order. It requires MODE=SHADOW and authenticated production read access.
LIVE_DRY_RUN_ENABLED=false

# ── Monitoring / integrations (later phases) ───────────────────────────
HEALTHCHECKS_PING_URL=
N8N_WEBHOOK_BASE_URL=
N8N_API_BEARER_TOKEN=
DASHBOARD_SESSION_SECRET=

# Dashboard API
DASHBOARD_TOKEN=
DASHBOARD_PORT=8777

# Decision engine (direct Anthropic API — needs a key when ai_enabled=true)
DECISION_PROVIDER=api
DECISION_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
RETENTION_DAYS=7
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
BACKUP_MAX_AGE_HOURS=26
# Optional rclone remote, for example: hetzner-box:kalshibot
BACKUP_RCLONE_DEST=
